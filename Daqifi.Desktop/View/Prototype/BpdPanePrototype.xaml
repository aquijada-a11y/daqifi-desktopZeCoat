<UserControl x:Class="Daqifi.Desktop.View.Prototype.BpdPanePrototype"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Daqifi.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BpdPaneViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>

        <!-- Brushes (Surface, BorderDim, TextPrimary, Accent, …) come from /Resources/DesignTokens.xaml via App.xaml. -->

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Named measurement readout tile. -->
        <DataTemplate x:Key="BpdMeasurementTemplate" DataType="{x:Type vm:BpdMeasurementViewModel}">
            <Border Width="176" Height="96" Margin="0,0,12,12"
                    AutomationProperties.AutomationId="{Binding Label}"
                    Background="{StaticResource SurfaceRaised}"
                    BorderBrush="{StaticResource BorderDim}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="14,12,14,12">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DisplayValue}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Consolas"
                                   FontSize="30"
                                   FontWeight="Medium"/>
                        <TextBlock Text="{Binding Unit}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   Margin="6,0,0,5"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TileWrap">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Dark toggle switch (matches the Channels pane switch). -->
        <Style x:Key="DarkToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{StaticResource BorderDim}"
                                BorderBrush="{StaticResource BorderBright}"
                                BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Thumb"
                                         Width="14" Height="14"
                                         Fill="{StaticResource TextSecondary}"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + status indicator -->
        <StackPanel Grid.Row="0" Margin="28,22,28,14">
            <TextBlock Text="BPD DIAGNOSTICS"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusCaption}"
                           AutomationProperties.AutomationId="BpdStatusCaption"
                           FontSize="24"
                           FontWeight="Light"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Measurement tiles -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,0,28,0">
            <StackPanel>
                <TextBlock Text="MEASUREMENTS" Style="{StaticResource SectionLabel}" Margin="0,8,0,10"/>
                <Rectangle Height="1"
                           Fill="{StaticResource BorderDim}"
                           Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding Measurements}"
                              AutomationProperties.AutomationId="BpdMeasurementList"
                              ItemTemplate="{StaticResource BpdMeasurementTemplate}"
                              ItemsPanel="{StaticResource TileWrap}"
                              Margin="0,0,0,24"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: simulation toggle -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource BorderDim}"
                BorderThickness="0,1,0,0"
                Padding="28,12,28,12">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource DarkToggleSwitch}"
                              AutomationProperties.AutomationId="BpdSimulationToggle"
                              IsChecked="{Binding IsSimulationEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Simulate data"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
                <TextBlock Text="Demo values until the C5 firmware streams these measurements."
                           Foreground="{StaticResource TextTertiary}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
